[Unit]
Description=Apply saved CPU governor
After=basic.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'STATE="__HOME__/.config/yakushidotfiles/governor"; if [[ -f "$STATE" ]]; then GOVERNOR=$(cat "$STATE"); case "$GOVERNOR" in performance|powersave) for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo "$GOVERNOR" > "$cpu"; done ;; esac; fi'

[Install]
WantedBy=multi-user.target
